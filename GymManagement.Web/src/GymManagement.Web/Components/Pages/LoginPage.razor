@page "/login"
@layout Layout.EmptyLayout
@using GymManagement.Application.Common.Interfaces
@using GymManagement.Application.Services
@using GymManagement.Domain.Enums
@inject ICurrentUserService CurrentUser
@inject IOrganizationService OrgService
@inject IMembershipService MemberService
@inject NavigationManager Navigation

<div class="gym-auth-page">
    <div class="gym-auth-overlay"></div>

    <div class="gym-auth-content">
        <div class="row align-items-center g-5 justify-content-center">
            <!-- Left Hero Section (Desktop only) -->
            <div class="col-lg-7 d-none d-lg-block text-white">
                <div class="d-flex align-items-center gap-2.5 mb-2.5">
                    <div class="gym-emblem" style="width: 44px; height: 44px; font-size: 1.25rem; margin-bottom: 0;">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div>
                        <div class="fw-bold tracking-tight" style="font-size: 1.25rem; letter-spacing: 0.05em; line-height: 1.1;">GYM</div>
                        <div class="text-secondary small text-uppercase" style="font-size: 0.62rem; letter-spacing: 0.12em; color: #a4ccc1 !important;">
                            Member and Inventory Management System
                        </div>
                    </div>
                </div>

                <div class="gym-hero-tag mb-1">Gym Management System</div>
                <h1 class="gym-hero-title">
                    Manage Your Gym<br />
                    <span class="text-neon-cyan">Smarter, Every Day.</span>
                </h1>
                <p class="gym-hero-desc mb-3">
                    A complete solution for member management, membership plans, supplement sales and inventory control — all in one smart platform.
                </p>

                <!-- 4 Quick Feature Glow Cards -->
                <div class="row g-2">
                    <div class="col-sm-6 col-md-3">
                        <div class="gym-feature-card">
                            <div class="gym-feature-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div>
                                <div class="gym-feature-title">Member Management</div>
                                <div class="gym-feature-sub">Keep your members organized and engaged.</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-3">
                        <div class="gym-feature-card">
                            <div class="gym-feature-icon">
                                <i class="bi bi-award-fill"></i>
                            </div>
                            <div>
                                <div class="gym-feature-title">Membership &amp; Promotions</div>
                                <div class="gym-feature-sub">Create plans and run promotions easily.</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-3">
                        <div class="gym-feature-card">
                            <div class="gym-feature-icon">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>
                            <div>
                                <div class="gym-feature-title">Sales &amp; Inventory</div>
                                <div class="gym-feature-sub">Manage supplement sales and stock in real time.</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-3">
                        <div class="gym-feature-card">
                            <div class="gym-feature-icon">
                                <i class="bi bi-bar-chart-line-fill"></i>
                            </div>
                            <div>
                                <div class="gym-feature-title">Smarter Insights</div>
                                <div class="gym-feature-sub">Get reports and insights to grow your business.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Floating Login Card -->
            <!-- Right Floating Login Card -->
            <div class="col-lg-5 col-12">
                <div class="gym-login-card">
                    <div class="gym-login-logo">
                        <div class="gym-emblem">
                            <i class="bi bi-activity"></i>
                        </div>
                        <div class="fw-bolder fs-6 text-dark" style="letter-spacing: 0.04em;">GYM</div>
                        <div class="text-muted" style="font-size: 0.62rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em;">
                            Member and Inventory Management System
                        </div>
                    </div>

                    <div class="text-center mb-2.5">
                        <h3 class="fw-bold text-dark mb-0 fs-5" style="letter-spacing: -0.02em;">Welcome Back</h3>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(LoginErrorMessage))
                    {
                        <div class="alert alert-warning py-1.5 px-2.5 small mb-2.5 d-flex align-items-center gap-2" style="font-size: 0.75rem;">
                            <i class="bi bi-phone-fill flex-shrink-0 text-warning fs-6"></i>
                            <div>@LoginErrorMessage</div>
                        </div>
                    }

                    <form @onsubmit="HandleLogin">
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-dark mb-0.5" style="font-size: 0.78rem;">Email or Username</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" class="form-control border-start-0" 
                                       placeholder="Enter your email or username" 
                                       @bind="Username" required />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-bold text-dark mb-0.5" style="font-size: 0.78rem;">Password</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="@(ShowPassword ? "text" : "password")" 
                                       class="form-control border-start-0 border-end-0" 
                                       placeholder="Enter your password" 
                                       @bind="Password" required />
                                <button type="button" class="input-group-text bg-light text-muted border-start-0" 
                                        @onclick="() => ShowPassword = !ShowPassword">
                                    <i class="bi @(ShowPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-bold text-dark mb-0.5" style="font-size: 0.78rem;">Branch / Outlet (Optional)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-building"></i>
                                </span>
                                <select class="form-select border-start-0" @bind="SelectedBranch">
                                    <option value="Downtown HQ">Downtown HQ (Titan Main)</option>
                                    <option value="Uptown Branch">Uptown Branch</option>
                                    <option value="Westside Fitness">Westside Fitness</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-2.5">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" @bind="RememberMe" />
                                <label class="form-check-label small text-secondary" for="rememberMe" style="font-size: 0.78rem;">
                                    Remember me
                                </label>
                            </div>
                            <button type="button" class="btn btn-link p-0 small text-decoration-none fw-semibold" 
                                    style="color: #00a383; font-size: 0.78rem;" 
                                    @onclick="OpenForgotPasswordModal">
                                Forgot password?
                            </button>
                        </div>

                        <button type="submit" class="btn btn-gym-signin w-100 mb-2 d-flex align-items-center justify-content-center gap-2 py-1.5">
                            <span>Sign In</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </form>

                    <!-- Fast Demo Switcher Pills -->
                    <div class="d-flex justify-content-center gap-1 mb-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0.5 px-2" style="font-size: 0.7rem;" @onclick="QuickSuperAdmin">
                            ⚡ Super Admin
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0.5 px-2" style="font-size: 0.7rem;" @onclick="QuickTenantAdmin">
                            🏢 Tenant HQ
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0.5 px-2" style="font-size: 0.7rem;" @onclick="QuickStaff">
                            🎯 Front Desk
                        </button>
                    </div>

                    <div class="position-relative text-center my-2">
                        <hr class="border-secondary border-opacity-25 my-1" />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 small text-muted" style="font-size: 0.7rem;">
                            Need Help?
                        </span>
                    </div>

                    <div class="admin-help-box mb-2 p-1.5 rounded-3 d-flex align-items-center gap-2" 
                         role="button" 
                         style="background: rgba(0, 184, 148, 0.08); border: 1px solid rgba(0, 184, 148, 0.2); cursor: pointer;" 
                         @onclick="OpenContactAdminModal">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 30px; height: 30px; background: rgba(0, 184, 148, 0.15); color: #00a383;">
                            <i class="bi bi-headset fs-6"></i>
                        </div>
                        <div class="flex-grow-1" style="line-height: 1.2;">
                            <div class="fw-bold text-dark" style="font-size: 0.78rem;">Contact Administrator</div>
                            <div class="text-secondary" style="font-size: 0.68rem;">For account access, contact system admin.</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted" style="font-size: 0.7rem;"></i>
                    </div>

                    <div class="text-center text-muted" style="font-size: 0.7rem;">
                        Powered by <strong class="text-dark">NEXARA Business Solutions</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Self-Service Forgot Password (OTP Verification) -->
@if (ShowForgotModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0 pt-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(0, 184, 148, 0.15); color: #00b894;">
                            <i class="bi bi-shield-lock-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark fs-6 mb-0">Reset Your Password</h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseForgotModal"></button>
                </div>

                <div class="modal-body px-4 py-3">
                    <!-- Step Progress Pills -->
                    <div class="d-flex align-items-center justify-content-between mb-3 px-2">
                        <div class="d-flex align-items-center gap-1.5 @(ForgotStep >= 1 ? "text-success fw-bold" : "text-muted")" style="font-size: 0.75rem;">
                            <span class="badge @(ForgotStep >= 1 ? "bg-success" : "bg-secondary") rounded-circle p-1" style="width: 20px; height: 20px;">1</span>
                            <span>Verify User</span>
                        </div>
                        <div class="flex-grow-1 border-top mx-2 @(ForgotStep >= 2 ? "border-success" : "border-secondary border-opacity-25")"></div>
                        <div class="d-flex align-items-center gap-1.5 @(ForgotStep >= 2 ? "text-success fw-bold" : "text-muted")" style="font-size: 0.75rem;">
                            <span class="badge @(ForgotStep >= 2 ? "bg-success" : "bg-secondary") rounded-circle p-1" style="width: 20px; height: 20px;">2</span>
                            <span>Enter OTP</span>
                        </div>
                        <div class="flex-grow-1 border-top mx-2 @(ForgotStep >= 3 ? "border-success" : "border-secondary border-opacity-25")"></div>
                        <div class="d-flex align-items-center gap-1.5 @(ForgotStep >= 3 ? "text-success fw-bold" : "text-muted")" style="font-size: 0.75rem;">
                            <span class="badge @(ForgotStep >= 3 ? "bg-success" : "bg-secondary") rounded-circle p-1" style="width: 20px; height: 20px;">3</span>
                            <span>Done</span>
                        </div>
                    </div>

                    @if (ForgotStep == 1)
                    {
                        <!-- Step 1: Account Identifier -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark mb-1">Username or Registered Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input type="text" class="form-control" 
                                       placeholder="e.g. reception_dt or titanadmin" 
                                       @bind="ForgotIdentifier" />
                            </div>
                            <div class="form-text text-muted" style="font-size: 0.75rem;">
                                We'll verify your staff/admin account and generate a 6-digit verification code.
                            </div>
                        </div>

                        <!-- Quick demo hint pills -->
                        <div class="p-2 mb-3 rounded-3 bg-light border small">
                            <span class="text-secondary" style="font-size: 0.72rem;">Quick test accounts:</span>
                            <div class="d-flex gap-1 mt-1">
                                <span class="badge bg-white text-dark border" role="button" style="cursor: pointer;" @onclick='() => ForgotIdentifier = "reception_dt"'>reception_dt</span>
                                <span class="badge bg-white text-dark border" role="button" style="cursor: pointer;" @onclick='() => ForgotIdentifier = "titanadmin"'>titanadmin</span>
                                <span class="badge bg-white text-dark border" role="button" style="cursor: pointer;" @onclick='() => ForgotIdentifier = "superadmin"'>superadmin</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ForgotMessage))
                        {
                            <div class="alert @(ForgotSuccess ? "alert-success" : "alert-danger") py-2 small mb-2 d-flex align-items-center gap-2">
                                <i class="bi @(ForgotSuccess ? "bi-check-circle" : "bi-exclamation-circle")"></i>
                                <span>@ForgotMessage</span>
                            </div>
                        }

                        <button type="button" class="btn btn-success w-100 py-2 d-flex align-items-center justify-content-center gap-2" 
                                @onclick="SubmitForgotStep1" 
                                disabled="@(string.IsNullOrWhiteSpace(ForgotIdentifier) || IsProcessingForgot)">
                            @if (IsProcessingForgot)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Checking account...</span>
                            }
                            else
                            {
                                <span>Send Verification Code</span>
                                <i class="bi bi-arrow-right"></i>
                            }
                        </button>
                    }
                    else if (ForgotStep == 2)
                    {
                        <!-- Step 2: OTP Verification & New Password -->
                        @if (!string.IsNullOrWhiteSpace(DemoOtpHint))
                        {
                            <div class="alert alert-info py-2 px-3 small mb-3 rounded-3 d-flex align-items-center justify-content-between">
                                <div>
                                    <i class="bi bi-chat-left-dots-fill me-1"></i>
                                    <span>Demo Verification Code:</span>
                                    <strong class="font-monospace fs-6 ms-1 text-primary">@DemoOtpHint</strong>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.7rem;" @onclick="() => ForgotOtp = DemoOtpHint">
                                    Auto Fill
                                </button>
                            </div>
                        }

                        <div class="mb-2.5">
                            <label class="form-label small fw-bold text-dark mb-1">6-Digit Verification Code</label>
                            <input type="text" class="form-control text-center font-monospace fw-bold fs-5 tracking-widest" 
                                   maxlength="6" 
                                   placeholder="000000" 
                                   @bind="ForgotOtp" />
                        </div>

                        <div class="mb-2.5">
                            <label class="form-label small fw-bold text-dark mb-1">New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                <input type="@(ShowForgotNewPassword ? "text" : "password")" 
                                       class="form-control" 
                                       placeholder="Enter new password (min 6 characters)" 
                                       @bind="ForgotNewPassword" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => ShowForgotNewPassword = !ShowForgotNewPassword">
                                    <i class="bi @(ShowForgotNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark mb-1">Confirm New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input type="@(ShowForgotNewPassword ? "text" : "password")" 
                                       class="form-control" 
                                       placeholder="Re-enter new password" 
                                       @bind="ForgotConfirmPassword" />
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ForgotMessage))
                        {
                            <div class="alert @(ForgotSuccess ? "alert-success" : "alert-danger") py-2 small mb-2 d-flex align-items-center gap-2">
                                <i class="bi @(ForgotSuccess ? "bi-check-circle" : "bi-exclamation-circle")"></i>
                                <span>@ForgotMessage</span>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary w-50 py-2" @onclick="() => ForgotStep = 1">
                                <i class="bi bi-arrow-left me-1"></i>Back
                            </button>
                            <button type="button" class="btn btn-success w-50 py-2 d-flex align-items-center justify-content-center gap-1" 
                                    @onclick="SubmitForgotStep2" 
                                    disabled="@(string.IsNullOrWhiteSpace(ForgotOtp) || string.IsNullOrWhiteSpace(ForgotNewPassword) || IsProcessingForgot)">
                                @if (IsProcessingForgot)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Resetting...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-1"></i>
                                    <span>Reset Password</span>
                                }
                            </button>
                        </div>
                    }
                    else if (ForgotStep == 3)
                    {
                        <!-- Step 3: Success -->
                        <div class="text-center py-3">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                                 style="width: 60px; height: 60px; background: rgba(0, 184, 148, 0.15); color: #00b894;">
                                <i class="bi bi-check-lg fs-1"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Password Successfully Changed!</h5>
                            <p class="text-secondary small mb-3">
                                Your account password has been updated. You can now sign in using your new credentials.
                            </p>
                            <button type="button" class="btn btn-success w-100 py-2 d-flex align-items-center justify-content-center gap-2" 
                                    @onclick="SignInWithNewCredentials">
                                <span>Sign In Now</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 2: Contact Administrator & HQ Support -->
@if (ShowContactModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0 pt-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(0, 184, 148, 0.15); color: #00b894;">
                            <i class="bi bi-headset fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark fs-6 mb-0">Contact System Administrator</h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseContactModal"></button>
                </div>

                <div class="modal-body px-4 py-3">
                    <!-- Role Reset Hierarchy Policy Banner -->
                    <div class="p-3 mb-3 rounded-3 bg-light border small">
                        <div class="fw-bold text-dark mb-1.5 d-flex align-items-center gap-1.5">
                            <i class="bi bi-info-circle-fill text-primary"></i>
                            <span>Password Reset Hierarchy:</span>
                        </div>
                        <ul class="mb-0 ps-3 text-secondary" style="font-size: 0.75rem; line-height: 1.5;">
                            <li><strong>Branch Staff / Reception:</strong> Please request your <em>Gym HQ General Manager</em> to reset your password via Organization Settings.</li>
                            <li><strong>Gym HQ Admin / Owners:</strong> Please contact <em>NEXARA Super Admin Support</em> for master recovery.</li>
                        </ul>
                    </div>

                    <!-- Direct Contact Cards -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-2.5 rounded-3 border bg-white text-center">
                                <i class="bi bi-telephone-fill text-success fs-5 mb-1 d-block"></i>
                                <div class="fw-bold text-dark" style="font-size: 0.78rem;">Phone Hotline</div>
                                <div class="text-secondary small font-monospace" style="font-size: 0.72rem;">09 778 899 001</div>
                                <div class="text-muted" style="font-size: 0.65rem;">24/7 Available</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2.5 rounded-3 border bg-white text-center">
                                <i class="bi bi-envelope-at-fill text-primary fs-5 mb-1 d-block"></i>
                                <div class="fw-bold text-dark" style="font-size: 0.78rem;">Support Email</div>
                                <div class="text-secondary small" style="font-size: 0.72rem;">support@nexara.com</div>
                                <div class="text-muted" style="font-size: 0.65rem;">Average reply: 15 min</div>
                            </div>
                        </div>
                    </div>

                    @if (!ContactRequestSent)
                    {
                        <!-- Quick Help Request Form -->
                        <div class="border-top pt-2.5">
                            <div class="fw-bold text-dark small mb-2">Submit Urgent Password Reset Request</div>
                            <div class="mb-2">
                                <label class="form-label small text-muted mb-0.5" style="font-size: 0.72rem;">Your Username or Staff Name</label>
                                <input type="text" class="form-control form-control-sm" placeholder="e.g. reception_dt" @bind="ContactUsername" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-muted mb-0.5" style="font-size: 0.72rem;">Contact Phone Number</label>
                                <input type="text" class="form-control form-control-sm" placeholder="e.g. 09 450 011 226" @bind="ContactPhone" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small text-muted mb-0.5" style="font-size: 0.72rem;">Notes (Optional)</label>
                                <input type="text" class="form-control form-control-sm" placeholder="e.g. Locked out of branch terminal" @bind="ContactNotes" />
                            </div>

                            <button type="button" class="btn btn-outline-success btn-sm w-100 py-1.5 fw-semibold" 
                                    @onclick="SubmitContactRequest" 
                                    disabled="@(string.IsNullOrWhiteSpace(ContactUsername) || string.IsNullOrWhiteSpace(ContactPhone))">
                                <i class="bi bi-send me-1"></i>Submit Reset Request to HQ
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success py-2.5 px-3 small rounded-3 d-flex align-items-center gap-2 mb-0">
                            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                            <div>
                                <div class="fw-bold text-dark">Request #REQ-9842 Logged!</div>
                                <div class="text-secondary" style="font-size: 0.72rem;">
                                    Your request has been forwarded to your Gym HQ Administrator. They will reset your account or call your phone shortly.
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer border-top-0 pt-0 pb-3 px-4">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" @onclick="CloseContactModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string Username = "admin";
    private string Password = "••••••••";
    private string SelectedBranch = "Downtown HQ";
    private bool RememberMe = true;
    private bool ShowPassword = false;

    // Forgot Password Flow State
    private bool ShowForgotModal = false;
    private int ForgotStep = 1;
    private string ForgotIdentifier = string.Empty;
    private string ForgotOtp = string.Empty;
    private string ForgotNewPassword = string.Empty;
    private string ForgotConfirmPassword = string.Empty;
    private bool ShowForgotNewPassword = false;
    private string DemoOtpHint = string.Empty;
    private string ForgotMessage = string.Empty;
    private bool ForgotSuccess = false;
    private bool IsProcessingForgot = false;

    // Contact Admin Modal State
    private bool ShowContactModal = false;
    private string ContactUsername = string.Empty;
    private string ContactPhone = string.Empty;
    private string ContactNotes = string.Empty;
    private bool ContactRequestSent = false;

    private string LoginErrorMessage = string.Empty;

    private void HandleLogin()
    {
        LoginErrorMessage = string.Empty;

        // Prevent members from logging in through the web portal
        if (Username.StartsWith("MBR", StringComparison.OrdinalIgnoreCase))
        {
            LoginErrorMessage = "Gym members must access via the Titan Fitness Mobile App. This web portal is strictly for Gym Staff and Administrators.";
            return;
        }

        if (Username.Contains("super", StringComparison.OrdinalIgnoreCase))
        {
            CurrentUser.SetContext(null, null, 1, "superadmin", UserRole.SuperAdmin);
            Navigation.NavigateTo("/");
        }
        else if (Username.Contains("staff", StringComparison.OrdinalIgnoreCase) || Username.Contains("reception", StringComparison.OrdinalIgnoreCase))
        {
            CurrentUser.SetContext(1, 1, 3, "reception_dt", UserRole.FrontDeskStaff);
            Navigation.NavigateTo("/staff/checkin");
        }
        else
        {
            CurrentUser.SetContext(1, 1, 2, "titanadmin", UserRole.TenantAdmin);
            Navigation.NavigateTo("/admin/dashboard");
        }
    }

    private void QuickSuperAdmin()
    {
        LoginErrorMessage = string.Empty;
        Username = "superadmin";
        CurrentUser.SetContext(null, null, 1, "superadmin", UserRole.SuperAdmin);
        Navigation.NavigateTo("/");
    }

    private void QuickTenantAdmin()
    {
        LoginErrorMessage = string.Empty;
        Username = "titanadmin";
        CurrentUser.SetContext(1, 1, 2, "titanadmin", UserRole.TenantAdmin);
        Navigation.NavigateTo("/admin/dashboard");
    }

    private void QuickStaff()
    {
        LoginErrorMessage = string.Empty;
        Username = "reception_dt";
        CurrentUser.SetContext(1, 1, 3, "reception_dt", UserRole.FrontDeskStaff);
        Navigation.NavigateTo("/staff/checkin");
    }

    // Modal Actions: Forgot Password
    private void OpenForgotPasswordModal()
    {
        ForgotStep = 1;
        ForgotIdentifier = string.IsNullOrWhiteSpace(Username) || Username == "admin" ? "reception_dt" : Username;
        ForgotOtp = string.Empty;
        ForgotNewPassword = string.Empty;
        ForgotConfirmPassword = string.Empty;
        ForgotMessage = string.Empty;
        ForgotSuccess = false;
        DemoOtpHint = string.Empty;
        IsProcessingForgot = false;
        ShowForgotModal = true;
    }

    private void CloseForgotModal()
    {
        ShowForgotModal = false;
    }

    private async Task SubmitForgotStep1()
    {
        if (string.IsNullOrWhiteSpace(ForgotIdentifier)) return;

        IsProcessingForgot = true;
        ForgotMessage = string.Empty;

        try
        {
            var res = await OrgService.RequestPasswordResetOtpAsync(ForgotIdentifier.Trim());
            if (res.Success)
            {
                ForgotSuccess = true;
                ForgotMessage = res.Message;
                DemoOtpHint = res.DemoOtp ?? "849201";
                ForgotStep = 2;
            }
            else
            {
                ForgotSuccess = false;
                ForgotMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            ForgotSuccess = false;
            ForgotMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsProcessingForgot = false;
        }
    }

    private async Task SubmitForgotStep2()
    {
        if (string.IsNullOrWhiteSpace(ForgotOtp) || string.IsNullOrWhiteSpace(ForgotNewPassword))
        {
            ForgotSuccess = false;
            ForgotMessage = "Please enter both the verification code and your new password.";
            return;
        }

        if (ForgotNewPassword.Length < 6)
        {
            ForgotSuccess = false;
            ForgotMessage = "Password must be at least 6 characters.";
            return;
        }

        if (ForgotNewPassword != ForgotConfirmPassword)
        {
            ForgotSuccess = false;
            ForgotMessage = "Passwords do not match. Please re-enter.";
            return;
        }

        IsProcessingForgot = true;
        ForgotMessage = string.Empty;

        try
        {
            var res = await OrgService.ResetPasswordWithOtpAsync(ForgotIdentifier.Trim(), ForgotOtp.Trim(), ForgotNewPassword.Trim());
            if (res.Success)
            {
                ForgotSuccess = true;
                ForgotStep = 3;
            }
            else
            {
                ForgotSuccess = false;
                ForgotMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            ForgotSuccess = false;
            ForgotMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsProcessingForgot = false;
        }
    }

    private void SignInWithNewCredentials()
    {
        Username = ForgotIdentifier;
        Password = ForgotNewPassword;
        ShowForgotModal = false;
        HandleLogin();
    }

    // Modal Actions: Contact Admin
    private void OpenContactAdminModal()
    {
        ContactUsername = Username == "admin" ? "reception_dt" : Username;
        ContactPhone = string.Empty;
        ContactNotes = string.Empty;
        ContactRequestSent = false;
        ShowContactModal = true;
    }

    private void CloseContactModal()
    {
        ShowContactModal = false;
    }

    private void SubmitContactRequest()
    {
        ContactRequestSent = true;
    }
}
