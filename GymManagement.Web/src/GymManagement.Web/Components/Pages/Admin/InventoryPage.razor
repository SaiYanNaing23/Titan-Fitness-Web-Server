<!-- Modal: Dispatch Stock to Branch -->
@if (ShowDispatchModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-truck me-2 text-primary"></i>HQ Stock Dispatch to Branch
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => ShowDispatchModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Source Branch (Origin)</label>
                            <select class="form-select" @bind="SourceBranchId">
                                @foreach (var b in Branches)
                                {
                                    <option value="@b.Id">@b.BranchName</option>
                                }
                            </select>
                            <div class="text-muted small mt-1">Stock will be deducted from this branch immediately upon dispatch.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Destination Branch (Target)</label>
                            <select class="form-select" @bind="DestBranchId">
                                @foreach (var b in Branches.Where(b => b.Id != SourceBranchId))
                                {
                                    <option value="@b.Id">@b.BranchName</option>
                                }
                            </select>
                            <div class="text-muted small mt-1">Stock will be added to this branch once confirmed received.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select Product to Distribute</label>
                        <select class="form-select" @bind="SelectedProductId">
                            @foreach (var p in Products)
                            {
                                var avail = p.BranchStocks.FirstOrDefault(b => b.BranchId == SourceBranchId)?.QuantityOnHand ?? 0;
                                <option value="@p.Id">@p.ProductName (Available at Origin: @avail)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Quantity to Dispatch</label>
                            <input type="number" class="form-control" @bind="DispatchQty" min="1" max="@MaxAvailableQty" />
                            <div class="small text-muted mt-1">Max available at source: <strong>@MaxAvailableQty</strong> units</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Dispatch Notes / Reference</label>
                            <input type="text" class="form-control" @bind="DispatchNotes" placeholder="e.g. Weekly branch stock replenishment" />
                        </div>
                    </div>

                    @if (ErrorMessage != null)
                    {
                        <div class="alert alert-danger py-2 small mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>@ErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => ShowDispatchModal = false">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SubmitDispatch" disabled="@(DispatchQty <= 0 || DispatchQty > MaxAvailableQty)">
                        <i class="bi bi-send-check me-1"></i> Confirm &amp; Dispatch Stock
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Review & Adjust Stock Requisition before Dispatch -->
@if (ShowApproveModal && SelectedRequestToApprove != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(2px);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="modal-header bg-light py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="modal-title fs-6 fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-sliders2 text-primary"></i>
                        Review &amp; Adjust Requisition (@SelectedRequestToApprove.RequestNumber)
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => ShowApproveModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="row g-2 small">
                            <div class="col-sm-4">
                                <span class="text-secondary">Destination Branch:</span>
                                <div class="fw-bold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(SelectedRequestToApprove.RequestingBranch?.BranchName ?? "Branch")</div>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-secondary">Requested Date:</span>
                                <div class="fw-bold text-dark">@SelectedRequestToApprove.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</div>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-secondary">Requested By:</span>
                                <div class="fw-bold text-dark">@(SelectedRequestToApprove.RequestedBy ?? "Branch Staff")</div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-info-circle-fill text-info fs-5 flex-shrink-0"></i>
                        <div>
                            Branch မှ မှာယူထားသော အရေအတွက် (Requested Qty) ကို Central HQ လက်ကျန်ပေါ်မူတည်၍ ပေးပို့မည့် အရေအတွက် (Approved Qty) အား manual adjust ပြင်ဆင်သတ်မှတ်ပေးနိုင်ပါသည်။
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(ApproveErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@ApproveErrorMessage
                        </div>
                    }

                    <div class="table-responsive border rounded-3 mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3 py-2">Product Name</th>
                                    <th class="text-center py-2">HQ Available Stock</th>
                                    <th class="text-center py-2">Branch Requested</th>
                                    <th class="text-center py-2" style="width: 170px;">Approved / Dispatch Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var it in SelectedRequestToApprove.Items)
                                {
                                    var hqAvail = GetHqStockForItem(it.ProductId);
                                    var currApproved = EditItemQuantities.TryGetValue(it.Id, out var q) ? q : it.RequestedQuantity;
                                    var isAdjusted = currApproved != it.RequestedQuantity;

                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold text-dark">@(it.Product?.ProductName ?? $"Product #{it.ProductId}")</div>
                                            <div class="text-muted small" style="font-size: 0.72rem;">@(it.Product?.Category?.CategoryName ?? "General")</div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(hqAvail > 0 ? "bg-success bg-opacity-10 text-success border border-success border-opacity-50" : "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-50") px-2.5 py-1">
                                                @hqAvail pcs
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-2.5 py-1 fw-bold">
                                                @it.RequestedQuantity pcs
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex flex-column align-items-center">
                                                <div class="input-group input-group-sm" style="max-width: 130px;">
                                                    <input type="number" 
                                                           class="form-control text-center fw-bold @(isAdjusted ? "border-warning text-primary" : "")" 
                                                           min="0" 
                                                           max="@hqAvail" 
                                                           value="@currApproved"
                                                           @onchange="(ChangeEventArgs e) => UpdateApprovedQty(it.Id, e.Value)" />
                                                    <span class="input-group-text">pcs</span>
                                                </div>
                                                @if (isAdjusted)
                                                {
                                                    <span class="badge bg-warning bg-opacity-25 text-dark mt-1" style="font-size: 0.68rem;">
                                                        Adjusted (@(currApproved < it.RequestedQuantity ? $"-{it.RequestedQuantity - currApproved}" : $"+{currApproved - it.RequestedQuantity}"))
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary">HQ Allocation Note / Remark (Optional)</label>
                        <input type="text" class="form-control form-control-sm" @bind="ApproveNotes" placeholder="e.g. Adjusted to 5 pcs due to warehouse stock rationing across branches" />
                    </div>
                </div>
                <div class="modal-footer bg-light py-2.5 border-top">
                    <button class="btn btn-secondary btn-sm px-3" @onclick="() => ShowApproveModal = false">Cancel</button>
                    <button class="btn btn-primary btn-sm px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" @onclick="ConfirmApproveAndDispatch">
                        <i class="bi bi-send-check"></i>
                        <span>Confirm Approval &amp; Dispatch</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string ActiveTab = "STOCK";

    private string SearchText = string.Empty;
    private string SelectedCategory = string.Empty;

    private List<ProductDto> Products = new();
    private List<StockPnLDto> PnLList = new();
    private List<BranchDto> Branches = new();
    private List<StockRequest> AllDispatches = new();

    private IEnumerable<string> Categories => Products
        .Select(p => p.CategoryName)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Select(c => c!)
        .Distinct()
        .OrderBy(c => c);

    private List<ProductDto> FilteredProducts
    {
        get
        {
            var query = Products.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var term = SearchText.Trim();
                query = query.Where(p =>
                    (!string.IsNullOrEmpty(p.ProductName) && p.ProductName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(p.Barcode) && p.Barcode.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }
            if (!string.IsNullOrWhiteSpace(SelectedCategory))
            {
                query = query.Where(p => string.Equals(p.CategoryName, SelectedCategory, StringComparison.OrdinalIgnoreCase));
            }
            return query.ToList();
        }
    }

    private List<StockPnLDto> FilteredPnLList
    {
        get
        {
            var query = PnLList.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var term = SearchText.Trim();
                query = query.Where(p =>
                    !string.IsNullOrEmpty(p.ProductName) && p.ProductName.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(SelectedCategory))
            {
                var matchingProductIds = Products
                    .Where(p => string.Equals(p.CategoryName, SelectedCategory, StringComparison.OrdinalIgnoreCase))
                    .Select(p => p.Id)
                    .ToHashSet();
                query = query.Where(p => matchingProductIds.Contains(p.ProductId));
            }
            return query.ToList();
        }
    }

    private StockRequestStatus? DistributionFilter = null;
    private List<StockRequest> FilteredDispatches => DistributionFilter.HasValue
        ? AllDispatches.Where(d => d.Status == DistributionFilter.Value).ToList()
        : AllDispatches;

    private int ActiveTransitCount => AllDispatches.Count(d => d.Status == StockRequestStatus.InTransit);
    private int PendingRequestsCount => AllDispatches.Count(d => d.Status == StockRequestStatus.Pending);

    private bool ShowPriceModal = false;
    private ProductDto? SelectedProduct;
    private decimal NewSalePrice;
    private decimal NewCostPrice;
    private string PriceChangeReason = string.Empty;

    private bool ShowAddModal = false;
    private ProductDto NewProduct = new() { CostPrice = 10000, SalePrice = 15000, BranchStock = 10, UnitOfMeasure = "pcs" };

    private bool ShowPromoModal = false;
    private string PromoTitle = string.Empty;
    private int PromoProductId;
    private decimal PromoDiscountPrice;

    private bool ShowDispatchModal = false;
    private int SourceBranchId;
    private int DestBranchId;
    private int SelectedProductId;
    private int DispatchQty = 1;
    private string DispatchNotes = string.Empty;
    private string? ErrorMessage;

    private int MaxAvailableQty
    {
        get
        {
            var p = Products.FirstOrDefault(x => x.Id == SelectedProductId);
            if (p == null) return 0;
            return p.BranchStocks.FirstOrDefault(b => b.BranchId == SourceBranchId)?.QuantityOnHand ?? 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private bool IsModuleDisabled = false;

    private async Task LoadData()
    {
        if (CurrentUser.TenantId.HasValue)
        {
            var tenant = await TenantService.GetTenantByIdAsync(CurrentUser.TenantId.Value);
            if (tenant != null && !tenant.InventoryModuleEnabled)
            {
                IsModuleDisabled = true;
                return;
            }
        }
        IsModuleDisabled = false;

        Branches = await OrgService.GetBranchesAsync();
        Products = await InventoryService.GetProductsAsync();
        PnLList = await InventoryService.GetStockPnLAsync();
        AllDispatches = await InventoryService.GetStockRequestsAsync();

        if (Products.Count > 0 && PromoProductId == 0)
        {
            PromoProductId = Products[0].Id;
            PromoDiscountPrice = Products[0].SalePrice * 0.9m;
        }

        if (Branches.Count > 0 && SourceBranchId == 0)
        {
            SourceBranchId = Branches[0].Id;
            DestBranchId = Branches.Count > 1 ? Branches[1].Id : Branches[0].Id;
        }

        if (Products.Count > 0 && SelectedProductId == 0)
        {
            SelectedProductId = Products[0].Id;
        }
    }

    private string GetShortBranchName(string name)
    {
        if (string.IsNullOrEmpty(name)) return "Branch";
        var shortName = name.Replace("Titan ", "").Replace("Flex ", "").Trim();
        return string.IsNullOrEmpty(shortName) ? name : shortName;
    }

    private int GetProductBranchQty(ProductDto p, int branchId) =>
        p.BranchStocks.FirstOrDefault(b => b.BranchId == branchId)?.QuantityOnHand ?? 0;

    private int GetPnLBranchQty(StockPnLDto p, int branchId) =>
        p.BranchStocks.FirstOrDefault(b => b.BranchId == branchId)?.QuantityOnHand ?? 0;

    private void OpenPriceChangeModal(ProductDto p)
    {
        SelectedProduct = p;
        NewSalePrice = p.SalePrice;
        NewCostPrice = p.CostPrice;
        PriceChangeReason = "Market price update";
        ShowPriceModal = true;
    }

    private async Task SavePriceChange()
    {
        if (SelectedProduct == null) return;
        await InventoryService.UpdateProductPriceAsync(SelectedProduct.Id, NewSalePrice, NewCostPrice, PriceChangeReason);
        ShowPriceModal = false;
        await LoadData();
    }

    private void OpenAddProductModal()
    {
        NewProduct = new ProductDto { CostPrice = 10000, SalePrice = 15000, BranchStock = 10, UnitOfMeasure = "pcs" };
        ShowAddModal = true;
    }

    private async Task SaveNewProduct()
    {
        if (string.IsNullOrWhiteSpace(NewProduct.ProductName)) return;
        await InventoryService.CreateProductAsync(NewProduct);
        ShowAddModal = false;
        await LoadData();
    }

    private void OpenPromotionModal()
    {
        PromoTitle = "Special Member Promo";
        ShowPromoModal = true;
    }

    private async Task SavePromotion()
    {
        if (PromoProductId <= 0 || PromoDiscountPrice <= 0) return;
        await InventoryService.CreatePromotionAsync(PromoTitle, PromoProductId, PromoDiscountPrice, DateTime.UtcNow.AddDays(-1), DateTime.UtcNow.AddDays(14));
        ShowPromoModal = false;
        await LoadData();
    }

    private void OpenDispatchModal()
    {
        ErrorMessage = null;
        DispatchQty = 1;
        DispatchNotes = "Routine branch stock distribution";
        if (Branches.Count > 0)
        {
            SourceBranchId = Branches[0].Id;
            DestBranchId = Branches.Count > 1 ? Branches[1].Id : Branches[0].Id;
        }
        if (Products.Count > 0)
        {
            SelectedProductId = Products[0].Id;
        }
        ShowDispatchModal = true;
    }

    private async Task SubmitDispatch()
    {
        ErrorMessage = null;
        if (SourceBranchId == DestBranchId)
        {
            ErrorMessage = "Source branch and Destination branch cannot be the same.";
            return;
        }

        if (DispatchQty <= 0)
        {
            ErrorMessage = "Dispatch quantity must be greater than 0.";
            return;
        }

        if (DispatchQty > MaxAvailableQty)
        {
            ErrorMessage = $"Cannot dispatch {DispatchQty} units. Only {MaxAvailableQty} units available at source branch.";
            return;
        }

        var items = new List<(int productId, int qty)> { (SelectedProductId, DispatchQty) };
        var senderName = CurrentUser.Username ?? "HQ Admin";

        await InventoryService.DispatchStockFromHqAsync(SourceBranchId, DestBranchId, items, senderName, DispatchNotes);
        ShowDispatchModal = false;
        ActiveTab = "DISTRIBUTION";
        await LoadData();
    }

    private bool ShowApproveModal = false;
    private StockRequest? SelectedRequestToApprove;
    private Dictionary<int, int> EditItemQuantities = new();
    private string ApproveNotes = string.Empty;
    private string? ApproveErrorMessage;

    private void OpenApproveModal(StockRequest req)
    {
        SelectedRequestToApprove = req;
        EditItemQuantities = req.Items.ToDictionary(i => i.Id, i => i.RequestedQuantity);
        ApproveNotes = string.Empty;
        ApproveErrorMessage = null;
        ShowApproveModal = true;
    }

    private void UpdateApprovedQty(int itemId, object? value)
    {
        if (int.TryParse(value?.ToString(), out var qty))
        {
            EditItemQuantities[itemId] = Math.Max(0, qty);
        }
    }

    private int GetHqStockForItem(int productId)
    {
        int sourceId = SelectedRequestToApprove?.FulfillingBranchId ?? 1;
        var prod = Products.FirstOrDefault(p => p.Id == productId);
        if (prod == null) return 0;
        return prod.BranchStocks.FirstOrDefault(b => b.BranchId == sourceId)?.QuantityOnHand ?? 0;
    }

    private async Task ConfirmApproveAndDispatch()
    {
        if (SelectedRequestToApprove == null) return;

        ApproveErrorMessage = null;

        // Validation against central warehouse available stock
        foreach (var item in SelectedRequestToApprove.Items)
        {
            var qty = EditItemQuantities.TryGetValue(item.Id, out var q) ? q : item.RequestedQuantity;
            if (qty < 0)
            {
                ApproveErrorMessage = "Approved quantity cannot be negative.";
                return;
            }

            var available = GetHqStockForItem(item.ProductId);
            if (qty > available)
            {
                var prodName = item.Product?.ProductName ?? "Product";
                ApproveErrorMessage = $"Cannot approve {qty} units of '{prodName}'. Central HQ only has {available} units available.";
                return;
            }
        }

        var approver = CurrentUser.Username ?? "Central HQ Admin";
        await InventoryService.ApproveStockRequestAsync(SelectedRequestToApprove.Id, approver, EditItemQuantities, ApproveNotes);
        ShowApproveModal = false;
        await LoadData();
    }
}

