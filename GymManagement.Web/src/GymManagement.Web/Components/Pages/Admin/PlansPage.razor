@page "/admin/plans"
@using GymManagement.Application.Services
@using GymManagement.Domain.Entities
@inject IMembershipService MemberService

<div class="page-header-row mb-3">
    <div>
        <div class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-collection-fill text-primary"></i>
            <span>Membership &amp; Promotions Hub</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (ActiveTab == "PACKAGES")
        {
            <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center gap-1.5" @onclick="OpenPlanModal">
                <i class="bi bi-plus-lg"></i>
                <span>Add Membership Package</span>
            </button>
        }
        else
        {
            <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center gap-1.5" @onclick="OpenAddPromotionModal">
                <i class="bi bi-plus-lg"></i>
                <span>Create New Promo</span>
            </button>
        }
    </div>
</div>

<!-- Unified Hub Tab Card -->
<div class="gym-card mb-4">
    <div class="card-header bg-transparent border-bottom px-4 pt-3 pb-0">
        <ul class="nav nav-tabs border-0 gap-2">
            <li class="nav-item">
                <button class="nav-link px-4 py-2.5 fw-semibold @(ActiveTab == "PACKAGES" ? "active" : "")"
                        @onclick='() => ActiveTab = "PACKAGES"'>
                    <i class="bi bi-card-checklist me-2"></i>Membership Packages
                    <span class="badge rounded-pill bg-light text-secondary ms-2 border">@Plans.Count Packages</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link px-4 py-2.5 fw-semibold @(ActiveTab == "PROMOTIONS" ? "active" : "")"
                        @onclick='() => ActiveTab = "PROMOTIONS"'>
                    <i class="bi bi-tags-fill me-2"></i>Active Member Discounts
                    <span class="badge rounded-pill bg-light text-secondary ms-2 border">@Promotions.Count(p => p.IsCurrentlyValid) Valid</span>
                </button>
            </li>
        </ul>
    </div>
</div>

<!-- Tab 1: Membership Packages (Member Types) -->
@if (ActiveTab == "PACKAGES")
{
    <div class="gym-card shadow-sm border">
        <div class="gym-card-header d-flex justify-content-between align-items-center py-3 px-4">
            <div>
                <h6 class="mb-0 fw-bold text-dark">Membership Packages &amp; Pricing Directory</h6>
            </div>
            <button class="btn btn-outline-primary btn-sm" @onclick="OpenPlanModal">
                <i class="bi bi-plus-lg me-1"></i> Add Package
            </button>
        </div>
        <div class="table-responsive">
            <table class="gym-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Plan Name</th>
                        <th>Validity Period</th>
                        <th>Price (MMK)</th>
                        <th>Multi-Branch Access</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Plans.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 text-secondary d-block mb-2"></i>
                                No membership packages found. Click "Add Membership Package" to get started.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Plans)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">@p.PlanName</div>
                                    @if (!string.IsNullOrEmpty(p.Description))
                                    {
                                        <div class="text-muted small" style="font-size: 0.78rem;">@p.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-secondary">
                                        <i class="bi bi-calendar3 me-1 text-primary"></i>@p.DurationDays Days
                                    </span>
                                    <small class="text-muted ms-1" style="font-size: 0.75rem;">
                                        @(p.DurationDays == 30 ? "(1 Month)" : p.DurationDays == 90 ? "(3 Months)" : p.DurationDays == 365 ? "(1 Year VIP)" : $"({Math.Round((double)p.DurationDays / 30, 1)} Mos)")
                                    </small>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary fs-6">@p.BasePrice.ToString("N0") MMK</span>
                                </td>
                                <td>
                                    <span class="badge @(p.IsMultiBranchAllowed ? "bg-success" : "bg-secondary") px-2.5 py-1.5 rounded-pill">
                                        <i class="bi @(p.IsMultiBranchAllowed ? "bi-check-all" : "bi-geo-alt") me-1"></i>
                                        @(p.IsMultiBranchAllowed ? "All Branches" : "Home Branch Only")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-clean badge-active">Active</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@* Tab 2: Active Member Discounts & Promos *@
else if (ActiveTab == "PROMOTIONS")
{
    <!-- Filter & Control Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="btn-group shadow-sm" role="group">
            <button type="button" class="btn btn-sm @(PromoFilter == "ALL" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick='() => PromoFilter = "ALL"'>
                All Discounts (@Promotions.Count)
            </button>
            <button type="button" class="btn btn-sm @(PromoFilter == "ACTIVE" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick='() => PromoFilter = "ACTIVE"'>
                <i class="bi bi-check-circle me-1"></i>Valid Now (@Promotions.Count(p => p.IsCurrentlyValid))
            </button>
            <button type="button" class="btn btn-sm @(PromoFilter == "EXPIRED" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick='() => PromoFilter = "EXPIRED"'>
                <i class="bi bi-clock-history me-1"></i>Expired (@Promotions.Count(p => p.IsExpired))
            </button>
        </div>

        <button class="btn btn-outline-primary btn-sm" @onclick="OpenAddPromotionModal">
            <i class="bi bi-plus-lg me-1"></i> New Promotion
        </button>
    </div>

    <!-- Promotions Responsive Grid -->
    @if (!DisplayedPromotions.Any())
    {
        <div class="gym-card p-5 text-center text-muted shadow-sm border">
            <i class="bi bi-tags fs-1 text-secondary d-block mb-3"></i>
            <h6 class="fw-bold text-dark">No promotions found</h6>
            <p class="small text-muted mb-3">There are no promotions under this filter category.</p>
            <button class="btn btn-primary btn-sm" @onclick="OpenAddPromotionModal">
                <i class="bi bi-plus-lg me-1"></i> Create First Promotion
            </button>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var promo in DisplayedPromotions)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="gym-card h-100 shadow-sm border position-relative @(promo.IsExpired ? "bg-light bg-opacity-75 border-secondary border-opacity-25" : "")">
                        <div class="gym-card-body p-3.5 d-flex flex-column justify-content-between h-100">
                            <div>
                                <!-- Header: Title & Discount Badge -->
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div class="fw-bold @(promo.IsExpired ? "text-muted" : "text-dark")" style="font-size: 1rem; line-height: 1.3;">
                                        @promo.PromotionTitle
                                    </div>
                                    @if (promo.DiscountPercent > 0)
                                    {
                                        <span class="badge bg-danger fs-6 px-2.5 py-1.5 rounded-pill shadow-sm flex-shrink-0">
                                            @promo.DiscountPercent.ToString("G29")% OFF
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary fs-6 px-2.5 py-1.5 rounded-pill shadow-sm flex-shrink-0">
                                            @promo.DiscountAmount.ToString("N0") MMK OFF
                                        </span>
                                    }
                                </div>

                                <!-- Description / Terms -->
                                @if (!string.IsNullOrEmpty(promo.Description))
                                {
                                    <p class="text-secondary small mb-3" style="font-size: 0.82rem; line-height: 1.4;">
                                        @promo.Description
                                    </p>
                                }

                                <!-- Status Badge -->
                                <div class="mb-3">
                                    @if (!promo.IsActive)
                                    {
                                        <span class="badge bg-secondary px-2 py-1 rounded-pill" style="font-size: 0.72rem;">
                                            <i class="bi bi-pause-circle me-1"></i>Disabled
                                        </span>
                                    }
                                    else if (promo.IsExpired)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                            <i class="bi bi-clock-history me-1"></i>Expired (No Longer Valid)
                                        </span>
                                    }
                                    else if (promo.IsUpcoming)
                                    {
                                        <span class="badge bg-info text-dark px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                            <i class="bi bi-calendar-event me-1"></i>Upcoming Promotion
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                            <i class="bi bi-check-circle me-1"></i>Active &amp; Eligible
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Footer Section: Validity Period & Actions -->
                            <div class="pt-3 border-top mt-2">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="text-muted small" style="font-size: 0.75rem;">
                                        @if (promo.IsExpired)
                                        {
                                            <div class="text-danger fw-semibold" title="Expired at this time">
                                                <i class="bi bi-exclamation-circle me-1"></i>Expired: @promo.ValidTo.ToString("dd MMM yyyy, hh:mm tt")
                                            </div>
                                        }
                                        else
                                        {
                                            <div title="Valid until this date & time">
                                                <i class="bi bi-clock-history me-1 text-primary"></i>Ends: <strong class="text-dark">@promo.ValidTo.ToString("dd MMM yyyy, hh:mm tt")</strong>
                                            </div>
                                        }
                                        <div class="text-muted mt-0.5" style="font-size: 0.7rem;">
                                            Started: @promo.ValidFrom.ToString("dd MMM yyyy, hh:mm tt")
                                        </div>
                                    </div>

                                    <div class="d-flex gap-1.5 flex-shrink-0">
                                        <button class="btn btn-outline-secondary btn-sm py-1 px-2.5" style="font-size: 0.78rem;" title="Edit this promotion" @onclick="() => OpenEditPromotionModal(promo)">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm py-1 px-2" style="font-size: 0.78rem;" title="Delete this promotion" @onclick="() => ConfirmDeletePromotion(promo.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- Modal: Add Membership Plan -->
@if (ShowPlanModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Membership Plan</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowPlanModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Plan Name</label>
                        <input class="form-control" @bind="PlanName" placeholder="e.g. 6-Months Gold Pass" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Duration (Days)</label>
                            <input type="number" class="form-control" @bind="DurationDays" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Base Price (MMK)</label>
                            <input type="number" class="form-control" @bind="Price" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="multiBranchCheck" @bind="IsMultiBranch" />
                        <label class="form-check-label small" for="multiBranchCheck">
                            Allow Cross-Branch Access (All Branches)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => ShowPlanModal = false">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SavePlan">Save Plan</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Add / Edit Member Promotion -->
@if (ShowPromoModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(EditingPromoId == 0 ? "Create Member Promotion" : "Edit Member Promotion")
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => ShowPromoModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Promotion Title</label>
                        <input class="form-control" @bind="PromoTitle" placeholder="e.g. Summer Fitness Kickstart" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description / Terms</label>
                        <input class="form-control" @bind="PromoDescription" placeholder="e.g. Applicable for 3-Month and Annual VIP plans" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Discount Type</label>
                            <select class="form-select" @bind="PromoDiscountType">
                                <option value="PERCENT">Percentage (% OFF)</option>
                                <option value="FIXED">Fixed Amount (MMK OFF)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">
                                @(PromoDiscountType == "PERCENT" ? "Discount Percentage (%)" : "Discount Amount (MMK)")
                            </label>
                            <input type="number" class="form-control" @bind="PromoDiscountValue" min="1" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">
                                <i class="bi bi-calendar-event me-1 text-primary"></i>Start Date &amp; Time
                            </label>
                            <input type="datetime-local" class="form-control" @bind="PromoValidFrom" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">
                                <i class="bi bi-calendar-check me-1 text-danger"></i>Expired Date &amp; Time
                            </label>
                            <input type="datetime-local" class="form-control" @bind="PromoValidTo" />
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="promoActiveCheck" @bind="PromoIsActive" />
                        <label class="form-check-label small" for="promoActiveCheck">
                            Active (Enabled)
                        </label>
                    </div>

                    <div class="alert alert-info py-2 px-3 small mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        သတ်မှတ်ထားသော <strong>Expired Date &amp; Time</strong> ရောက်သည်နှင့် ဤ Promotion သည် အလိုအလျောက် သက်တမ်းကုန်ဆုံးပြီး စနစ်အတွင်း အကြုံးမဝင်တော့ပါ။
                    </div>

                    @if (!string.IsNullOrEmpty(PromoErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small mt-2 mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>@PromoErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => ShowPromoModal = false">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SavePromotion">
                        @(EditingPromoId == 0 ? "Create Promotion" : "Save Changes")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MembershipPlan> Plans = new();
    private List<MemberPromotion> Promotions = new();

    private string ActiveTab = "PACKAGES"; // "PACKAGES" or "PROMOTIONS"
    private string PromoFilter = "ALL"; // "ALL", "ACTIVE", "EXPIRED"

    private IEnumerable<MemberPromotion> DisplayedPromotions => PromoFilter switch
    {
        "ACTIVE" => Promotions.Where(p => p.IsCurrentlyValid),
        "EXPIRED" => Promotions.Where(p => p.IsExpired),
        _ => Promotions
    };

    private bool ShowPlanModal = false;
    private string PlanName = string.Empty;
    private int DurationDays = 30;
    private decimal Price = 70000;
    private bool IsMultiBranch = true;

    // Promotion Modal State
    private bool ShowPromoModal = false;
    private int EditingPromoId = 0;
    private string PromoTitle = string.Empty;
    private string PromoDescription = string.Empty;
    private string PromoDiscountType = "PERCENT";
    private decimal PromoDiscountValue = 15;
    private DateTime PromoValidFrom = DateTime.UtcNow;
    private DateTime PromoValidTo = DateTime.UtcNow.AddDays(14);
    private bool PromoIsActive = true;
    private string? PromoErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        Plans = await MemberService.GetPlansAsync();
        Promotions = await MemberService.GetPromotionsAsync();
    }

    private void OpenPlanModal()
    {
        PlanName = string.Empty;
        DurationDays = 30;
        Price = 70000;
        IsMultiBranch = true;
        ShowPlanModal = true;
    }

    private async Task SavePlan()
    {
        if (string.IsNullOrWhiteSpace(PlanName) || Price <= 0) return;
        await MemberService.CreatePlanAsync(PlanName, DurationDays, Price, IsMultiBranch);
        ShowPlanModal = false;
        await LoadData();
    }

    private void OpenAddPromotionModal()
    {
        EditingPromoId = 0;
        PromoTitle = string.Empty;
        PromoDescription = string.Empty;
        PromoDiscountType = "PERCENT";
        PromoDiscountValue = 10;
        PromoValidFrom = DateTime.UtcNow;
        PromoValidTo = DateTime.UtcNow.AddDays(14);
        PromoIsActive = true;
        PromoErrorMessage = null;
        ShowPromoModal = true;
    }

    private void OpenEditPromotionModal(MemberPromotion promo)
    {
        EditingPromoId = promo.Id;
        PromoTitle = promo.PromotionTitle;
        PromoDescription = promo.Description ?? string.Empty;
        if (promo.DiscountPercent > 0)
        {
            PromoDiscountType = "PERCENT";
            PromoDiscountValue = promo.DiscountPercent;
        }
        else
        {
            PromoDiscountType = "FIXED";
            PromoDiscountValue = promo.DiscountAmount;
        }
        PromoValidFrom = promo.ValidFrom;
        PromoValidTo = promo.ValidTo;
        PromoIsActive = promo.IsActive;
        PromoErrorMessage = null;
        ShowPromoModal = true;
    }

    private async Task SavePromotion()
    {
        PromoErrorMessage = null;
        if (string.IsNullOrWhiteSpace(PromoTitle))
        {
            PromoErrorMessage = "Promotion Title is required.";
            return;
        }
        if (PromoDiscountValue <= 0)
        {
            PromoErrorMessage = "Discount value must be greater than 0.";
            return;
        }
        if (PromoValidTo <= PromoValidFrom)
        {
            PromoErrorMessage = "Expired Date & Time must be after Start Date & Time.";
            return;
        }

        decimal discountPercent = PromoDiscountType == "PERCENT" ? PromoDiscountValue : 0;
        decimal discountAmount = PromoDiscountType == "FIXED" ? PromoDiscountValue : 0;

        if (EditingPromoId == 0)
        {
            await MemberService.CreatePromotionAsync(PromoTitle, PromoDescription, discountPercent, discountAmount, PromoValidFrom, PromoValidTo);
        }
        else
        {
            await MemberService.UpdatePromotionAsync(EditingPromoId, PromoTitle, PromoDescription, discountPercent, discountAmount, PromoValidFrom, PromoValidTo, PromoIsActive);
        }

        ShowPromoModal = false;
        await LoadData();
    }

    private async Task ConfirmDeletePromotion(int promoId)
    {
        await MemberService.DeletePromotionAsync(promoId);
        await LoadData();
    }
}
