@page "/superadmin/permissions"
@using GymManagement.Application.Common.Interfaces
@using GymManagement.Application.DTOs
@using GymManagement.Application.Services
@using GymManagement.Domain.Enums
@inject ITenantService TenantService
@inject IOrganizationService OrgService
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation

<div class="page-header-row">
    <div class="page-title">Tenant Subscriptions &amp; Entitlements</div>
</div>

<!-- Tenant Selector Card -->
<div class="gym-card p-3 mb-4">
    <div class="row align-items-center g-3">
        <div class="col-auto">
            <label class="form-label mb-0 fw-bold text-nowrap">
                <i class="bi bi-buildings me-2 text-primary"></i>Select Tenant:
            </label>
        </div>
        <div class="col-md-5 col-sm-8">
            <select class="form-select gym-input" @bind="SelectedTenantId">
                <option value="0">-- Select a Tenant Company --</option>
                @foreach (var t in Tenants)
                {
                    <option value="@t.Id">@t.CompanyName</option>
                }
            </select>
        </div>
        @if (SelectedTenant != null)
        {
            <div class="col-auto ms-auto d-flex align-items-center gap-3">
                <span class="badge @(SelectedTenant.Status == TenantStatus.Active ? "bg-success" : "bg-secondary")">
                    @SelectedTenant.Status
                </span>
                <span class="text-muted small">
                    <i class="bi bi-people me-1 text-primary"></i>@SelectedTenant.ActiveMemberCount Active Members
                </span>
            </div>
        }
    </div>
</div>

@if (SelectedTenant == null)
{
    <div class="gym-card p-5 text-center my-4">
        <div class="mb-3 text-muted">
            <i class="bi bi-buildings fs-1"></i>
        </div>
        <h5 class="fw-bold mb-2">No Tenant Selected</h5>
        <p class="text-muted mb-0">
            Please select a tenant company above to view and manage its feature entitlements and staff accounts.
        </p>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <!-- Left Side: Feature & Entitlements -->
        <div class="col-lg-6">
            <div class="gym-card h-100 d-flex flex-column">
                <div class="gym-card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-sliders2 me-2 text-primary"></i>Feature &amp; Entitlements</span>
                    <span class="badge bg-primary bg-opacity-25 text-primary">@SelectedTenant.CompanyName</span>
                </div>
                <div class="p-3 flex-grow-1 d-flex flex-column gap-3 justify-content-center">
                    <!-- 🏢 Branch Quota Limit Card -->
                    <div class="p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                <i class="bi bi-buildings"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Branch Quota Limit</div>
                                <div class="text-muted small">Max physical gym branches allowed</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fs-5 fw-bold text-primary">@SelectedTenant.MaxBranches <span class="fs-6 fw-normal text-muted">Branches</span></div>
                            <div class="text-muted small" style="font-size: 0.75rem;">(@SelectedTenant.BranchCount active currently)</div>
                        </div>
                    </div>

                    <!-- 📦 Inventory Module Card with Modern Switch -->
                    <div class="p-3 rounded-3 border d-flex align-items-center justify-content-between @(SelectedTenant.InventoryModuleEnabled ? "bg-success bg-opacity-10 border-success border-opacity-25" : "bg-light")">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 @(SelectedTenant.InventoryModuleEnabled ? "bg-success bg-opacity-25 text-success" : "bg-secondary bg-opacity-10 text-secondary")" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark">Inventory Module</span>
                                    <span class="badge @(SelectedTenant.InventoryModuleEnabled ? "bg-success" : "bg-secondary")">
                                        @(SelectedTenant.InventoryModuleEnabled ? "ON" : "OFF")
                                    </span>
                                </div>
                                <div class="text-muted small">Merchandise sales, supplement tracking &amp; POs</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center ps-2">
                            <div class="form-check form-switch m-0 fs-3">
                                <input class="form-check-input modern-switch" type="checkbox" role="switch"
                                       checked="@SelectedTenant.InventoryModuleEnabled"
                                       @onchange="() => ToggleInventory(SelectedTenant)"
                                       title="Toggle Inventory Module" />
                            </div>
                        </div>
                    </div>

                    <!-- 💳 Multi-Branch Pass Card with Modern Switch -->
                    <div class="p-3 rounded-3 border d-flex align-items-center justify-content-between @(SelectedTenant.MultiBranchAccessEnabled ? "bg-info bg-opacity-10 border-info border-opacity-25" : "bg-light")">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 @(SelectedTenant.MultiBranchAccessEnabled ? "bg-info bg-opacity-25 text-info" : "bg-secondary bg-opacity-10 text-secondary")" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                <i class="bi bi-credit-card-2-front"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark">Multi-Branch Pass</span>
                                    <span class="badge @(SelectedTenant.MultiBranchAccessEnabled ? "bg-info text-dark" : "bg-secondary")">
                                        @(SelectedTenant.MultiBranchAccessEnabled ? "ON" : "OFF")
                                    </span>
                                </div>
                                <div class="text-muted small">Cross-branch roaming check-in for members</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center ps-2">
                            <div class="form-check form-switch m-0 fs-3">
                                <input class="form-check-input modern-switch" type="checkbox" role="switch"
                                       checked="@SelectedTenant.MultiBranchAccessEnabled"
                                       @onchange="() => ToggleMultiBranch(SelectedTenant)"
                                       title="Toggle Multi-Branch Pass" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Staff Accounts & Roles -->
        <div class="col-lg-6">
            <div class="gym-card h-100 d-flex flex-column">
                <div class="gym-card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-people me-2 text-primary"></i>Staff Accounts &amp; Roles</span>
                    <span class="badge @(FilteredUsers.Any() ? "bg-primary" : "bg-secondary")">@FilteredUsers.Count Users</span>
                </div>
                <div class="p-3 flex-grow-1 d-flex flex-column justify-content-center">
                    @if (!FilteredUsers.Any())
                    {
                        <div class="p-4 text-center my-auto">
                            <div class="mb-3 text-secondary">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light p-3" style="width: 60px; height: 60px;">
                                    <i class="bi bi-people text-muted fs-2"></i>
                                </div>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">No Staff Accounts Registered</h6>
                            <p class="text-muted small mb-0" style="max-width: 320px; margin: 0 auto;">
                                There are currently no staff, manager, or admin user accounts under @SelectedTenant.CompanyName.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="gym-table mb-0">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Full Name</th>
                                        <th>Branch</th>
                                        <th>Role</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in FilteredUsers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                                        @(string.IsNullOrEmpty(u.Username) ? "U" : u.Username.Substring(0, 1).ToUpper())
                                                    </div>
                                                    <span class="fw-bold">@u.Username</span>
                                                </div>
                                            </td>
                                            <td>@u.FullName</td>
                                            <td class="text-muted small">@(string.IsNullOrEmpty(u.BranchName) ? "All Branches (HQ)" : u.BranchName)</td>
                                            <td>
                                                <span class="badge @(u.Role == UserRole.SuperAdmin ? "bg-danger" : (u.Role == UserRole.TenantAdmin ? "bg-primary" : "bg-dark"))">
                                                    @u.Role
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .modern-switch {
        cursor: pointer;
    }
    .modern-switch:checked {
        background-color: #00b894 !important;
        border-color: #00b894 !important;
    }
</style>

@code {
    private int SelectedTenantId = 0;
    private List<TenantDto> Tenants = new();
    private List<StaffUserDto> StaffUsers = new();

    private TenantDto? SelectedTenant => Tenants.FirstOrDefault(t => t.Id == SelectedTenantId);
    private List<StaffUserDto> FilteredUsers => SelectedTenantId > 0
        ? StaffUsers.Where(u => u.TenantId == SelectedTenantId).ToList()
        : new();

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsSuperAdmin)
        {
            Navigation.NavigateTo(CurrentUser.IsTenantAdmin ? "/admin/dashboard" : "/staff/checkin", replace: true);
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        Tenants = await TenantService.GetTenantsAsync();
        StaffUsers = await OrgService.GetStaffUsersAsync();
    }

    private async Task ToggleInventory(TenantDto t)
    {
        t.InventoryModuleEnabled = !t.InventoryModuleEnabled;
        await TenantService.UpdateTenantAsync(t);
        await LoadData();
    }

    private async Task ToggleMultiBranch(TenantDto t)
    {
        t.MultiBranchAccessEnabled = !t.MultiBranchAccessEnabled;
        await TenantService.UpdateTenantAsync(t);
        await LoadData();
    }
}
