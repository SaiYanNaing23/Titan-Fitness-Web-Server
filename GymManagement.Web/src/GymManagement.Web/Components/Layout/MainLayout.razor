@inherits LayoutComponentBase
@using GymManagement.Application.Common.Interfaces
@using GymManagement.Application.DTOs
@using GymManagement.Application.Services
@using GymManagement.Domain.Enums
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IPaymentNotificationService NotificationService
@implements IDisposable

<div class="app-layout">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        <header class="app-topbar d-flex align-items-center justify-content-between px-4">
            <!-- Left Header: Brand Emblem & Breadcrumbs matching screenshot -->
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2" role="button" style="cursor: pointer;" @onclick="NavigateToHome" title="Go to Dashboard">
                    <div class="gym-brand-logo-box">
                        <i class="bi bi-activity text-white fs-5"></i>
                    </div>
                    <div class="d-none d-sm-block" style="line-height: 1.15;">
                        <div class="fw-bold text-dark" style="font-size: 1.15rem; font-weight: 900; letter-spacing: 0.04em;">GYM</div>
                        <div class="text-muted" style="font-size: 0.65rem; font-weight: 600;">Member and Inventory<br/>Management System</div>
                    </div>
                </div>

                <div class="vr mx-2 text-secondary opacity-25 d-none d-md-block" style="height: 32px;"></div>

                <div class="breadcrumb-container">
                    <span class="breadcrumb-parent">@GetBreadcrumbParent()</span>
                    <span class="breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
                    <span class="breadcrumb-active">@GetBreadcrumbActive()</span>
                </div>
            </div>

            <!-- Right Header: Tenant Selector Pill, Notification Bell & User Profile Pill -->
            <div class="d-flex align-items-center gap-2.5">
                <div class="tenant-pill d-none d-md-flex">
                    <i class="bi bi-building text-success"></i>
                    <span>Tenant : <strong>@GetTenantName()</strong> (@GetTenantCode())</span>
                    <i class="bi bi-chevron-down text-muted" style="font-size: 0.72rem;"></i>
                </div>

                <!-- Interactive Payment Notification Bell (For Admins) -->
                @if (CurrentUser.IsTenantAdmin || CurrentUser.IsSuperAdmin)
                {
                    <div class="position-relative">
                        <button class="btn btn-light rounded-circle position-relative p-0 d-flex align-items-center justify-content-center border"
                                style="width: 38px; height: 38px; background: #ffffff; cursor: pointer;"
                                @onclick="ToggleNotificationMenu"
                                title="Real-Time Payment Notifications">
                            <i class="bi bi-bell-fill @(UnreadNotificationCount > 0 ? "text-primary" : "text-secondary") fs-6"></i>
                            @if (UnreadNotificationCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light"
                                      style="font-size: 0.65rem; padding: 0.25em 0.45em;">
                                    @UnreadNotificationCount
                                </span>
                            }
                        </button>

                        @if (ShowNotificationMenu)
                        {
                            <div class="dropdown-menu dropdown-menu-end shadow-lg border p-0 show d-block position-absolute end-0 top-100 mt-2" 
                                 style="min-width: 360px; max-width: 400px; z-index: 1055; border-radius: 14px; background: #ffffff;">
                                <div class="px-3 py-2.5 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-dark fs-6">
                                            <i class="bi bi-bell text-primary me-1"></i>Payments &amp; Collections
                                        </span>
                                        @if (UnreadNotificationCount > 0)
                                        {
                                            <span class="badge bg-danger rounded-pill" style="font-size: 0.68rem;">@UnreadNotificationCount New</span>
                                        }
                                    </div>
                                    @if (UnreadNotificationCount > 0)
                                    {
                                        <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted small" 
                                                style="font-size: 0.75rem;" 
                                                @onclick="MarkAllRead">
                                            Mark all read
                                        </button>
                                    }
                                </div>

                                <div class="notification-list-scroll" style="max-height: 380px; overflow-y: auto;">
                                    @if (RecentNotifications.Count == 0)
                                    {
                                        <div class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox fs-2 text-secondary opacity-50 d-block mb-1"></i>
                                            <div class="small">No payment notifications today.</div>
                                        </div>
                                    }
                                    @foreach (var n in RecentNotifications)
                                    {
                                        <div class="px-3 py-2.5 border-bottom d-flex align-items-start gap-2.5 @(!n.IsRead ? "bg-light bg-opacity-75" : "")" 
                                             style="cursor: pointer; transition: background 0.15s ease;"
                                             @onclick="() => NavigateFromNotification(n)">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 mt-0.5" 
                                                 style="width: 34px; height: 34px; background: @(n.TransactionType == "MEMBER_FEE" ? "rgba(0, 184, 148, 0.15); color: #00b894;" : "rgba(108, 92, 231, 0.15); color: #6c5ce7;")">
                                                <i class="bi @(n.TransactionType == "MEMBER_FEE" ? "bi-wallet2" : "bi-cart3") fs-6"></i>
                                            </div>
                                            <div class="flex-grow-1" style="line-height: 1.3;">
                                                <div class="d-flex justify-content-between align-items-center mb-0.5">
                                                    <span class="fw-bold text-dark small" style="font-size: 0.82rem;">
                                                        @(n.TransactionType == "MEMBER_FEE" ? "Member Fee Collection" : "POS Retail Sale")
                                                    </span>
                                                    <span class="fw-bold text-success font-monospace" style="font-size: 0.85rem;">
                                                        +@n.Amount.ToString("N0") MMK
                                                    </span>
                                                </div>
                                                <div class="text-secondary small mb-1" style="font-size: 0.75rem;">
                                                    <strong>@n.CustomerName</strong> &bull; @n.ItemDescription
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.68rem;">
                                                    <span><i class="bi bi-geo-alt me-0.5"></i>@n.BranchName (@n.PaymentMethod)</span>
                                                    <span class="font-monospace">@n.TimeAgo</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="p-2 text-center bg-light rounded-bottom-4 border-top">
                                    <button class="btn btn-sm btn-link text-primary text-decoration-none fw-bold w-100" 
                                            style="font-size: 0.8rem;" 
                                            @onclick="GoToDailyRevenue">
                                        Open Daily Revenue &amp; Audit Hub &rarr;
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Interactive Role & Profile Dropdown -->
                <div class="position-relative">
                    <div class="user-avatar-pill" @onclick="ToggleRoleMenu" title="Switch User Role or Sign Out">
                        <div class="user-avatar-circle">
                            @GetUserInitials()
                        </div>
                        <span>@GetRoleDisplayName()</span>
                        <i class="bi bi-chevron-down text-secondary" style="font-size: 0.72rem;"></i>
                    </div>

                    @if (ShowRoleMenu)
                    {
                        <div class="dropdown-menu dropdown-menu-end shadow border p-2 show d-block position-absolute end-0 top-100 mt-2" 
                             style="min-width: 290px; z-index: 1050; border-radius: 12px; background: #ffffff;">
                            <div class="px-2 py-1.5 mb-1 border-bottom d-flex justify-content-between align-items-center">
                                <span class="small text-uppercase fw-bold text-muted" style="font-size: 0.68rem; letter-spacing: 0.05em;">
                                    Switch RBAC Workspace
                                </span>
                                <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">Multi-Tenant RBAC</span>
                            </div>

                            <!-- 1. Super Admin -->
                            <button class="dropdown-item rounded-2 py-2 px-2.5 d-flex align-items-center gap-2.5 w-100 border-0 @(CurrentUser.IsSuperAdmin ? "active bg-primary bg-opacity-10 text-primary fw-bold" : "bg-transparent text-dark")" 
                                    @onclick='() => SwitchRole("SUPER_ADMIN")'>
                                <div class="rounded-circle p-1.5 bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-shield-shaded fs-5"></i>
                                </div>
                                <div class="text-start flex-grow-1">
                                    <div style="font-size: 0.85rem;">Super Admin</div>
                                    <div class="text-muted small" style="font-size: 0.7rem;">Platform, Tenants &amp; Invoices</div>
                                </div>
                                @if (CurrentUser.IsSuperAdmin)
                                {
                                    <i class="bi bi-check-circle-fill text-primary"></i>
                                }
                            </button>

                            <!-- 2. Tenant HQ Admin -->
                            <button class="dropdown-item rounded-2 py-2 px-2.5 d-flex align-items-center gap-2.5 w-100 border-0 @(CurrentUser.IsTenantAdmin ? "active bg-primary bg-opacity-10 text-primary fw-bold" : "bg-transparent text-dark")" 
                                    @onclick='() => SwitchRole("TENANT_ADMIN")'>
                                <div class="rounded-circle p-1.5 bg-primary bg-opacity-15 text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-building fs-5"></i>
                                </div>
                                <div class="text-start flex-grow-1">
                                    <div style="font-size: 0.85rem;">Tenant HQ Admin</div>
                                    <div class="text-muted small" style="font-size: 0.7rem;">Myanmar Fitness HQ (Stock, Plans, Org)</div>
                                </div>
                                @if (CurrentUser.IsTenantAdmin)
                                {
                                    <i class="bi bi-check-circle-fill text-primary"></i>
                                }
                            </button>

                            <!-- 3. Branch Staff -->
                            <button class="dropdown-item rounded-2 py-2 px-2.5 d-flex align-items-center gap-2.5 w-100 border-0 @(CurrentUser.IsBranchStaff ? "active bg-primary bg-opacity-10 text-primary fw-bold" : "bg-transparent text-dark")" 
                                    @onclick='() => SwitchRole("STAFF")'>
                                <div class="rounded-circle p-1.5 bg-success bg-opacity-15 text-success d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-person-badge fs-5"></i>
                                </div>
                                <div class="text-start flex-grow-1">
                                    <div style="font-size: 0.85rem;">Front Desk Staff</div>
                                    <div class="text-muted small" style="font-size: 0.7rem;">Downtown Branch (Check-In, POS, Members)</div>
                                </div>
                                @if (CurrentUser.IsBranchStaff)
                                {
                                    <i class="bi bi-check-circle-fill text-primary"></i>
                                }
                            </button>

                            <div class="dropdown-divider my-1.5"></div>

                            <button class="dropdown-item rounded-2 py-1.5 px-2.5 text-danger small d-flex align-items-center gap-2 w-100 border-0 bg-transparent" 
                                    @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Sign Out to Login Portal</span>
                            </button>
                        </div>
                    }
                </div>

                <!-- Quick Logout Button -->
                <button class="btn btn-outline-secondary btn-sm py-1.5 px-2.5 d-flex align-items-center gap-1.5 rounded-pill" @onclick="HandleLogout" title="Log Out">
                    <i class="bi bi-box-arrow-right text-danger"></i>
                    <span class="d-none d-sm-inline">Log Out</span>
                </button>
            </div>
        </header>

        <main class="app-content">
            <div class="app-content-container">
                @Body
            </div>
        </main>

        <!-- Real-Time Payment Toast Popup Alert (Floats top right when payment happens) -->
        @if (ActiveToastNotification != null)
        {
            <div class="position-fixed top-0 end-0 p-3" style="z-index: 1090; margin-top: 60px;">
                <div class="toast show shadow-lg border-0 rounded-4 overflow-hidden" 
                     style="min-width: 340px; max-width: 420px; background: #ffffff; border-left: 5px solid #00b894 !important; animation: slideInToast 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
                    <div class="p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-success bg-opacity-15 text-success fw-bold d-flex align-items-center gap-1.5 py-1 px-2.5" style="font-size: 0.72rem;">
                                <span class="pulse-dot"></span>
                                <span>LIVE PAYMENT NOTIFICATION</span>
                            </span>
                            <button type="button" class="btn-close" style="font-size: 0.72rem;" @onclick="DismissToast"></button>
                        </div>
                        <div class="d-flex align-items-baseline justify-content-between mb-1">
                            <span class="fw-bold fs-6 text-dark text-truncate" style="max-width: 200px;">@ActiveToastNotification.CustomerName</span>
                            <span class="fw-bold fs-5 text-success font-monospace">+@ActiveToastNotification.Amount.ToString("N0") <small class="fs-6 fw-normal">MMK</small></span>
                        </div>
                        <div class="text-secondary small mb-2" style="font-size: 0.78rem;">
                            <span>@ActiveToastNotification.ItemDescription</span>
                            <span class="mx-1.5">&bull;</span>
                            <span class="badge bg-light text-dark border">@ActiveToastNotification.PaymentMethod</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center text-muted border-top pt-2 mt-1" style="font-size: 0.72rem;">
                            <span><i class="bi bi-geo-alt me-1"></i>@ActiveToastNotification.BranchName &bull; Cashier: @ActiveToastNotification.CashierOrStaff</span>
                            <button class="btn btn-sm btn-outline-primary py-0.5 px-2.5 rounded-pill fw-bold" style="font-size: 0.72rem;" @onclick="GoToDailyRevenue">
                                View Ledger &rarr;
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- System Footer featuring NEXARA Logo (Fixed at bottom) -->
        <footer class="app-footer px-4 py-2 border-top bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2.5">
                <span class="text-secondary small fw-bold" style="font-size: 0.85rem;">Powered by</span>
                <img src="images/nexara-banner.png" alt="NEXARA Business Solutions" style="height: 38px; width: auto; object-fit: contain;" />
            </div>
            <div class="text-muted small d-none d-sm-block" style="font-size: 0.78rem;">
                &copy; @DateTime.Now.Year <strong>NEXARA Business Solutions</strong>. All rights reserved.
            </div>
        </footer>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool ShowRoleMenu = false;
    private bool ShowNotificationMenu = false;
    private List<PaymentNotificationDto> RecentNotifications = new();
    private int UnreadNotificationCount = 0;
    private PaymentNotificationDto? ActiveToastNotification;
    private System.Threading.Timer? _toastDismissTimer;

    private void ToggleRoleMenu()
    {
        ShowRoleMenu = !ShowRoleMenu;
        if (ShowRoleMenu) ShowNotificationMenu = false;
    }

    private void ToggleNotificationMenu()
    {
        ShowNotificationMenu = !ShowNotificationMenu;
        if (ShowNotificationMenu)
        {
            ShowRoleMenu = false;
            LoadNotifications();
        }
    }

    private void LoadNotifications()
    {
        int? tenantId = CurrentUser.IsSuperAdmin ? null : CurrentUser.TenantId;
        RecentNotifications = NotificationService.GetRecentNotifications(tenantId, 15);
        UnreadNotificationCount = NotificationService.GetUnreadCount(tenantId);
    }

    private void MarkAllRead()
    {
        int? tenantId = CurrentUser.IsSuperAdmin ? null : CurrentUser.TenantId;
        NotificationService.MarkAllAsRead(tenantId);
        LoadNotifications();
    }

    private void DismissToast()
    {
        ActiveToastNotification = null;
        _toastDismissTimer?.Dispose();
    }

    private void NavigateFromNotification(PaymentNotificationDto notif)
    {
        ShowNotificationMenu = false;
        NotificationService.MarkAsRead(notif.Id);
        LoadNotifications();
        Navigation.NavigateTo("/admin/daily-revenue");
    }

    private void GoToDailyRevenue()
    {
        ShowNotificationMenu = false;
        DismissToast();
        Navigation.NavigateTo("/admin/daily-revenue");
    }

    private async Task HandlePaymentNotificationReceived(PaymentNotificationDto notification)
    {
        if (CurrentUser.IsTenantAdmin || CurrentUser.IsSuperAdmin)
        {
            await InvokeAsync(() =>
            {
                LoadNotifications();
                ActiveToastNotification = notification;
                _toastDismissTimer?.Dispose();
                _toastDismissTimer = new System.Threading.Timer(_ =>
                {
                    InvokeAsync(() =>
                    {
                        ActiveToastNotification = null;
                        StateHasChanged();
                    });
                }, null, 7000, Timeout.Infinite);

                StateHasChanged();
            });
        }
    }

    private void SwitchRole(string target)
    {
        ShowRoleMenu = false;
        if (target == "SUPER_ADMIN")
        {
            CurrentUser.SetContext(null, null, 1, "superadmin", UserRole.SuperAdmin);
            Navigation.NavigateTo("/");
        }
        else if (target == "TENANT_ADMIN")
        {
            CurrentUser.SetContext(1, 1, 2, "titanadmin", UserRole.TenantAdmin);
            Navigation.NavigateTo("/admin/dashboard");
        }
        else if (target == "STAFF")
        {
            CurrentUser.SetContext(1, 1, 3, "staff_downtown", UserRole.FrontDeskStaff);
            Navigation.NavigateTo("/staff/checkin");
        }
    }

    private string GetBreadcrumbParent()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(path)) return CurrentUser.IsSuperAdmin ? "Super Admin" : "Tenant Management";
        if (path.StartsWith("superadmin/billing")) return "Super Admin";
        if (path.StartsWith("superadmin/permissions")) return "Super Admin";
        if (path.StartsWith("superadmin/audit-logs")) return "Super Admin";
        if (path.StartsWith("admin/organization")) return "Gym HQ";
        if (path.StartsWith("admin/dashboard")) return "Gym HQ";
        if (path.StartsWith("admin/daily-revenue")) return "Gym HQ";
        if (path.StartsWith("admin/plans")) return "Gym HQ";
        if (path.StartsWith("admin/inventory")) return "Operations";
        if (path.StartsWith("admin/stock-requests")) return "Inventory";
        if (path.StartsWith("admin/audit-logs")) return "Gym HQ";
        if (path.StartsWith("staff/checkin")) return "Branch Front Desk";
        if (path.StartsWith("staff/members")) return "Branch Front Desk";
        if (path.StartsWith("staff/alerts")) return "Branch Front Desk";
        if (path.StartsWith("staff/pos")) return "Branch Front Desk";
        if (path.StartsWith("staff/stock-requests")) return "Branch Operations";
        if (path.Contains("members")) return "Customer Relations";
        return CurrentUser.IsSuperAdmin ? "Super Admin" : "Gym HQ";
    }

    private string GetBreadcrumbActive()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(path)) return CurrentUser.IsSuperAdmin ? "Tenants Management" : "Dashboard";
        if (path.StartsWith("superadmin/billing")) return "Billing & Invoices";
        if (path.StartsWith("superadmin/permissions")) return "Tenant Subscriptions";
        if (path.StartsWith("superadmin/audit-logs")) return "System Audit Logs";
        if (path.StartsWith("admin/organization")) return "Branches & Staff";
        if (path.StartsWith("admin/dashboard")) return "Dashboard Overview";
        if (path.StartsWith("admin/daily-revenue")) return "Daily Revenue & Approvals";
        if (path.StartsWith("admin/plans")) return "Membership Plans";
        if (path.StartsWith("admin/inventory")) return "Inventory Management";
        if (path.StartsWith("admin/stock-requests")) return "Stock Requests";
        if (path.StartsWith("admin/audit-logs")) return "Activity & Audit Logs";
        if (path.StartsWith("staff/checkin")) return "Member Check-In";
        if (path.StartsWith("staff/members")) return "Members Directory";
        if (path.StartsWith("staff/alerts")) return "Due Period Alerts";
        if (path.StartsWith("staff/pos")) return "Point of Sale (POS)";
        if (path.StartsWith("staff/stock-requests")) return "Branch Stock Requests";
        if (path.Contains("members")) return "Members Directory";
        return CurrentUser.IsSuperAdmin ? "Tenants Management" : "Branches & Staff";
    }

    private void NavigateToHome()
    {
        if (CurrentUser.IsSuperAdmin)
        {
            Navigation.NavigateTo("/superadmin/tenants");
        }
        else if (CurrentUser.IsBranchStaff)
        {
            Navigation.NavigateTo("/staff/checkin");
        }
        else
        {
            Navigation.NavigateTo("/admin/dashboard");
        }
    }

    private string GetTenantName()
    {
        if (CurrentUser.IsSuperAdmin) return "Super Admin (Platform)";
        return "Titan Fitness Club";
    }

    private string GetTenantCode()
    {
        if (CurrentUser.IsSuperAdmin) return "PLATFORM";
        return "TITAN";
    }

    private string GetUserInitials()
    {
        if (CurrentUser.IsSuperAdmin) return "SA";
        if (CurrentUser.IsTenantAdmin) return "AA";
        if (CurrentUser.IsBranchStaff) return "FD";
        return "AA";
    }

    private string GetRoleDisplayName()
    {
        if (CurrentUser.IsSuperAdmin) return "Super Admin";
        if (CurrentUser.IsTenantAdmin) return "Admin";
        if (CurrentUser.IsBranchStaff) return "Front Desk";
        return "Admin";
    }

    private string GetRoleSubtitle()
    {
        if (CurrentUser.IsSuperAdmin) return "Platform Mode";
        if (CurrentUser.IsTenantAdmin) return "Myanmar Fitness HQ";
        if (CurrentUser.IsBranchStaff) return "Downtown Branch";
        return "Myanmar Fitness HQ";
    }

    private string GetRoleIcon()
    {
        if (CurrentUser.IsSuperAdmin) return "bi-shield-shaded";
        if (CurrentUser.IsTenantAdmin) return "bi-building";
        if (CurrentUser.IsBranchStaff) return "bi-person-badge";
        return "bi-building";
    }

    private string GetRolePillClass()
    {
        if (CurrentUser.IsSuperAdmin) return "bg-warning bg-opacity-20 text-warning";
        if (CurrentUser.IsTenantAdmin) return "bg-primary bg-opacity-20 text-primary";
        if (CurrentUser.IsBranchStaff) return "bg-success bg-opacity-20 text-success";
        return "bg-primary bg-opacity-20 text-primary";
    }

    private string GetWorkspaceTitle()
    {
        if (CurrentUser.IsSuperAdmin) return "Platform Central";
        if (CurrentUser.IsTenantAdmin) return "Tenant HQ Workspace";
        if (CurrentUser.IsBranchStaff) return "Branch Front Desk";
        return "Tenant HQ Workspace";
    }

    private string GetWorkspaceSubtitle()
    {
        if (CurrentUser.IsSuperAdmin) return "Multi-Tenant SaaS Administration";
        if (CurrentUser.IsTenantAdmin) return "Titan Fitness Club • HQ Portal";
        if (CurrentUser.IsBranchStaff) return "Downtown Branch • Daily Operations";
        return "Titan Fitness Club • HQ Portal";
    }

    private string GetWorkspaceBadgeClass()
    {
        if (CurrentUser.IsSuperAdmin) return "bg-warning bg-opacity-15 text-dark border border-warning border-opacity-25";
        if (CurrentUser.IsTenantAdmin) return "bg-primary bg-opacity-15 text-dark border border-primary border-opacity-25";
        if (CurrentUser.IsBranchStaff) return "bg-success bg-opacity-15 text-dark border border-success border-opacity-25";
        return "bg-primary bg-opacity-15 text-dark border border-primary border-opacity-25";
    }

    protected override void OnInitialized()
    {
        EnsureDefaultContext();
        Navigation.LocationChanged += HandleLocationChanged;
        NotificationService.OnPaymentReceived += HandlePaymentNotificationReceived;
        LoadNotifications();
    }

    private void EnsureDefaultContext()
    {
        if (CurrentUser.Role == null)
        {
            CurrentUser.SetContext(1, 1, 2, "titanadmin", UserRole.TenantAdmin);
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLogout()
    {
        CurrentUser.SetContext(null, null, null, null, null);
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        NotificationService.OnPaymentReceived -= HandlePaymentNotificationReceived;
        _toastDismissTimer?.Dispose();
    }
}
